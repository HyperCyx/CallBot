# =============================================================================
# SIPBOT - environment variables
# Copy to .env and fill in. NEVER commit a real .env file.
# =============================================================================

NODE_ENV=development
# debug | info | warn | error
LOG_LEVEL=info
# request id header used for correlating logs
LOG_PRETTY=true

# -----------------------------------------------------------------------------
# HTTP API (internal backend API; NOT exposed to Telegram directly)
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8080
# Shared secret required by admin/service-to-service API callers (header: x-api-key)
API_KEY=change-me-to-a-long-random-string
# Comma separated CIDR/IP allowlist for the admin API. Empty = allow all.
API_IP_ALLOWLIST=
# Max requests per minute per IP for the HTTP API
API_RATE_LIMIT_PER_MIN=120

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://sipbot:sipbot@127.0.0.1:5432/sipbot
PGPOOL_MAX=15
PG_STATEMENT_TIMEOUT_MS=8000

# -----------------------------------------------------------------------------
# Telegram
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Telegram user IDs that always have the SUPER_ADMIN role, comma separated.
# Example: 123456789,987654321
TELEGRAM_SUPER_ADMIN_IDS=
# Optional forced channel membership check ("@channelusername" or "-1001234567890").
# Leave empty to disable.
TELEGRAM_REQUIRED_CHANNEL=
# Optional support username without the @
SUPPORT_USERNAME=
# Secret token for Telegram webhook mode. If empty, long polling is used.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Secrets
# -----------------------------------------------------------------------------
# 32-byte key, base64 (openssl rand -base64 32). Encrypts SIP secrets at rest.
SECRETS_KEK_BASE64=
# HMAC key for signed internal links / idempotency tokens
SIGNING_KEY=change-me-too

# -----------------------------------------------------------------------------
# FreePBX / Asterisk  (backend only - never exposed to Telegram users)
# -----------------------------------------------------------------------------
# Base URL of the PBX GUI, no trailing slash. Example: https://pbx.example.com
FREEPBX_BASE_URL=
# From the PBX "API Applications" page (client_credentials / machine-to-machine app)
FREEPBX_CLIENT_ID=
FREEPBX_CLIENT_SECRET=
# From PBX -> API -> API URL List -> OAuth 2.0 URLs -> Token
# (typical default: <base>/admin/api/api/token )
FREEPBX_TOKEN_URL=
# From PBX -> API -> API URL List -> GraphQL URLs (default: <base>/admin/api/api/gql)
FREEPBX_GRAPHQL_URL=
# OAuth scope string, from the API Scope Visualizer. Space separated.
FREEPBX_SCOPE=
# PEM CA bundle (path) when the PBX uses a private CA. Empty = system CAs.
FREEPBX_CA_FILE=
# Verify TLS certificate (disable only for lab environments)
FREEPBX_TLS_VERIFY=true
# Milliseconds
FREEPBX_TIMEOUT_MS=10000
FREEPBX_MAX_RETRIES=2
# Outbound caller ID used when creating extensions
FREEPBX_DEFAULT_OUTBOUND_CID=
# 'graphql' (real PBX) or 'mock' (no PBX configured - deterministic in-memory test double)
FREEPBX_MODE=mock

# -----------------------------------------------------------------------------
# Asterisk Manager Interface (LIVE calls only - CDR is NOT live data)
# -----------------------------------------------------------------------------
AMI_ENABLED=false
AMI_HOST=127.0.0.1
AMI_PORT=5038
# A dedicated AMI user restricted to read/event permissions on the PBX
AMI_USER=
AMI_SECRET=
AMI_TLS=false
AMI_TLS_VERIFY=true
# Name of the FreePBX/Telnyx/... trunk channel prefix used to classify inbound calls
AMI_INBOUND_CHANNEL_PREFIX=PJSIP/

# -----------------------------------------------------------------------------
# Number assignment / routing behaviour
# -----------------------------------------------------------------------------
# Prefix applied to DID before the inbound route extension match (e.g. "1" for
# NANP-style trunks that deliver 11 digits). Leave empty to match as delivered.
DID_NORMALIZE_STRIP_PLUS=true
DID_PREFIX=
# Destination string template for inbound routes. {ext} is replaced by extension.
# Confirmed FreePBX GraphQL destination format: from-did-direct,<extension>,1
FREEPBX_ROUTE_DESTINATION_TEMPLATE=from-did-direct,{ext},1
# Extension number range allocated to users
EXTENSION_RANGE_START=10000
EXTENSION_RANGE_END=19999

# -----------------------------------------------------------------------------
# Business rules (defaults; all overridable from the Telegram admin panel and
# stored in admin_settings - nothing here is hard-coded in business logic)
# -----------------------------------------------------------------------------
DEFAULT_PLAN_CODE=free
MAX_NUMBER_REQUESTS_PER_MINUTE=5
MAX_START_PER_MINUTE=10
DEFAULT_USER_EXPIRES_DAYS=30
DEFAULT_NUMBER_EXPIRES_DAYS=30

# -----------------------------------------------------------------------------
# Workers
# -----------------------------------------------------------------------------
RECONCILE_INTERVAL_MS=300000
EXPIRY_SWEEP_INTERVAL_MS=900000
EXPIRY_NOTICE_DAYS=3,1
